<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Robe.Api</RootNamespace>
    <AssemblyName>Robe.Api</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="7.0.20" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\robe.core\robe.core.csproj" />
    <ProjectReference Include="..\robe.infrastructure\robe.infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local-only fakes config (mocked secrets, in-memory everything) must
         never ship to a deployed stage. The Web SDK auto-includes every
         appsettings*.json as publishable Content by default; override that
         here so dotnet publish drops it even though it stays available for
         local `dotnet run`/build. -->
    <Content Update="appsettings.Local.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>