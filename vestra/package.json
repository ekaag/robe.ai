  },
  "devDependencies": {
    "orval": "^7.3.0",
    "openapi-typescript": "^7.4.0",
    "turbo": "^2.3.3",
    "typescript": "^5.5.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
