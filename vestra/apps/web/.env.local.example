# Copy this file to .env.local and edit as needed. NEVER commit .env.local.
#
# ── Mode 1: local fakes (default for local dev) ─────────────────────────────
# Leave NEXT_PUBLIC_ENTRA_CLIENT_ID unset (commented out below).
# Frontend → FakeAuthProvider (pre-authenticated as "dev-user", no sign-in needed).
# Backend → LocalAuthHandler (decodes the fake JWT, no Entra tenant required).
# Start the backend with UseLocalFakes: true in appsettings.Local.json.

NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ── Mode 2: real Entra sign-in against the local API ────────────────────────
# Uncomment all four vars to use real Entra auth while still running the
# backend locally. Requires the Entra CIAM tenant to be configured.
# Backend must have Entra:Authority + Entra:ClientId set in appsettings.Local.json.

# NEXT_PUBLIC_ENTRA_AUTHORITY=https://vestraoauth.ciamlogin.com/vestraoauth.onmicrosoft.com
# NEXT_PUBLIC_ENTRA_CLIENT_ID=d4cd6bf9-9a9e-44e6-b7e5-12660e5e32d9
# NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000/auth/blank
# NEXT_PUBLIC_ENTRA_API_SCOPE=api://d4cd6bf9-9a9e-44e6-b7e5-12660e5e32d9/access_as_user
