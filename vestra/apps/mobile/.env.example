# Copy this file to .env and fill in your Entra External ID values.
# NEVER commit .env — secrets stay local.
#
# Entra External ID (CIAM) tenant:
EXPO_PUBLIC_ENTRA_AUTHORITY=https://<tenant>.ciamlogin.com/<tenant>.onmicrosoft.com
EXPO_PUBLIC_ENTRA_CLIENT_ID=
# The scope exposed by your backend app registration:
EXPO_PUBLIC_ENTRA_API_SCOPE=https://<tenant>.onmicrosoft.com/<app>/access_as_user

# Backend base URL (no trailing slash):
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
# Note: redirect URI is computed automatically via makeRedirectUri({ scheme: "vestra" }).
# Register "vestra://" as a redirect URI in your Entra app registration.
