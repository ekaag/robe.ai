# Copy this file to .env.local and fill in your Entra External ID values.
# NEVER commit .env.local — secrets stay local.
#
# Entra External ID (CIAM) tenant:
NEXT_PUBLIC_ENTRA_AUTHORITY=https://vestraoauth.ciamlogin.com/vestraoauth.onmicrosoft.com
NEXT_PUBLIC_ENTRA_CLIENT_ID=e0c48795-1873-43c3-88ad-06c0814a54e8
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000
# The scope exposed by your backend app registration:
NEXT_PUBLIC_ENTRA_API_SCOPE=https://vestraoauth.onmicrosoft.com/api://e0c48795-1873-43c3-88ad-06c0814a54e8/access_as_user

# Backend base URL (no trailing slash):
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000