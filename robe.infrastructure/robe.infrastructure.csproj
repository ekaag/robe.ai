<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Robe.Infrastructure</RootNamespace>
    <AssemblyName>Robe.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.46.0" />
    <!-- Required by Microsoft.Azure.Cosmos itself (query parsing, diagnostics, REST error
         envelopes) even though our own CosmosJsonSerializer uses System.Text.Json for document
         (de)serialization — the SDK's own internal code still calls into Newtonsoft.Json at
         runtime. Must be an explicit reference (not just transitive) or the assembly never gets
         restored/copied to the publish output, causing a FileNotFoundException at runtime the
         first time a real Cosmos call is made. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\robe.core\robe.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="robe.api.tests" />
  </ItemGroup>

</Project>
